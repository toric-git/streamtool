# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=みんなの効果音

# Supabase (Project Settings > API Keys)
# Prefer publishable/secret keys. Legacy anon/service_role also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_or_legacy_service_role_jwt

# Random secret mixed into OBS token hashes (example: openssl rand -hex 32)
OBS_TOKEN_PEPPER=replace_with_long_random_secret

# Comma-separated emails that can open /admin/feedback
# APP_ADMIN_EMAILS=you@example.com

# Local-only: skip the login screen (auto-login as a dedicated dev user).
# Ignored in production / Vercel. Only works on localhost / 127.0.0.1.
# DEV_AUTH_BYPASS=1
# Optional overrides (defaults shown):
# DEV_AUTH_EMAIL=dev@example.com
# DEV_AUTH_PASSWORD=dev-local-password
# DEV_AUTH_DISPLAY_NAME=開発ユーザー
