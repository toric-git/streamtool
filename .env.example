# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Streamtool

# Supabase (Project Settings > API Keys)
# Prefer publishable/secret keys. Legacy anon/service_role also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_or_legacy_service_role_jwt

# Random secret mixed into OBS token hashes (example: openssl rand -hex 32)
OBS_TOKEN_PEPPER=replace_with_long_random_secret
