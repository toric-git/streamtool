# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Streamtool

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — never expose to the browser.
# Used only for: password room join, OBS token ops, Storage cleanup,
# and OBS session member bootstrap.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Random secret mixed into OBS token hashes (example: openssl rand -hex 32)
OBS_TOKEN_PEPPER=replace_with_long_random_secret
